<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!-- Portrait only (android:screenOrientation below). Every screen is a single vertical
           column built around one large control — the record button, the meeting list — and
           landscape stretches those to unreadable line lengths while pushing the primary action
           off screen. Nothing here benefits from the extra width. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait"
        android:supportsPictureInPicture="true"
        android:resizeableActivity="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Invisible, finishes immediately. Its only job is to make the app briefly foreground so
           a tile tap can legally start the microphone foreground service. taskAffinity="" keeps
           it out of the main task, so it can never be what the user returns to. -->
      <activity
        android:name=".pipeline.ShimActivity"
        android:exported="false"
        android:theme="@android:style/Theme.NoDisplay"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- Quick Settings tile. BIND_QUICK_SETTINGS_TILE is signature-level and declared here
           rather than as a <uses-permission>: it is the system that must hold it to bind us. -->
      <service
        android:name=".pipeline.RecordTileService"
        android:exported="true"
        android:icon="@drawable/ic_notification_rec"
        android:label="@string/tile_label"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
        <intent-filter>
          <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
        <meta-data
          android:name="android.service.quicksettings.TOGGLEABLE_TILE"
          android:value="true" />
      </service>

      <!-- Persistent recording indicator + capture run in this foreground service.

           stopWithTask="false" is stated explicitly rather than left to the default: swiping the
           app out of Recents is how people tidy their task list, not how they end a meeting, and
           the primary way this app is used is with the phone set down and another app in front.
           RecordingService.onTaskRemoved is then the deliberate decision point. -->
      <service
        android:name=".pipeline.RecordingService"
        android:exported="false"
        android:stopWithTask="false"
        android:foregroundServiceType="microphone" />

      <!-- Routes taps on the PiP window's Pause/Resume/Stop buttons to CaptureController. -->
      <receiver
        android:name=".pipeline.PipActionReceiver"
        android:exported="false" />

      <!-- Share exported minutes via a content URI. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
