<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <!--
        Crashlytics collects NOTHING until somebody says yes.

        TWO switches, and both are needed before any JavaScript runs. The first is Google's own,
        read by the Crashlytics SDK. The second is react-native-firebase's: its init provider runs
        at process start, reads `rnfirebase_crashlytics_auto_collection_enabled` (default TRUE) and
        calls setCrashlyticsCollectionEnabled with whatever it found — which OVERRIDES the first
        key. With only the first key set, the Galaxy A07 logged "isCrashlyticsCollectionEnabled via
        RNFBMeta: true" on a phone nobody had consented on, and Crashlytics fetched its settings
        from Google's server in the second before App.tsx applied the stored consent. Every launch.
        src/telemetry/crash.ts flips collection on at runtime once consent is recorded, and back
        off when it is withdrawn; these two keys are what hold the line until it runs.
        src/telemetry/__tests__/manifest.test.ts fails if either key is missing or not false.
      -->
      <meta-data
        android:name="firebase_crashlytics_collection_enabled"
        android:value="false" />
      <meta-data
        android:name="rnfirebase_crashlytics_auto_collection_enabled"
        android:value="false" />
      <!--
        Analytics is not a dependency of this app and must not become one by transitive addition.
        Off explicitly, so adding a Firebase library later cannot quietly switch it on.
      -->
      <meta-data
        android:name="firebase_analytics_collection_enabled"
        android:value="false" />
      <meta-data
        android:name="google_analytics_adid_collection_enabled"
        android:value="false" />
      <!-- Portrait only (android:screenOrientation below). Every screen is a single vertical
           column built around one large control — the record button, the meeting list — and
           landscape stretches those to unreadable line lengths while pushing the primary action
           off screen. Nothing here benefits from the extra width. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait"
        android:supportsPictureInPicture="true"
        android:resizeableActivity="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- Audio shared from another app: a WhatsApp voice note, a recording made elsewhere.
             The pipeline needs only that it becomes 16 kHz mono PCM on disk, which AudioImport
             does, so a shared file becomes an ordinary meeting with an ordinary transcript.

             application/octet-stream is listed on purpose. Providers routinely hand over a voice
             note under it, and being absent from the share sheet for the single most common way
             people receive audio would defeat the point. The decoder decides what is really
             audio; this only decides what we are offered. -->
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="audio/*" />
            <data android:mimeType="application/ogg" />
            <data android:mimeType="application/octet-stream" />
        </intent-filter>

        <!-- A file manager opening a recording with us. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:mimeType="audio/*" />
        </intent-filter>
      </activity>

      <!-- Invisible, finishes immediately. Its only job is to make the app briefly foreground so
           a tile tap can legally start the microphone foreground service. taskAffinity="" keeps
           it out of the main task, so it can never be what the user returns to. -->
      <activity
        android:name=".pipeline.ShimActivity"
        android:exported="false"
        android:theme="@android:style/Theme.NoDisplay"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:noHistory="true" />

      <!-- Quick Settings tile. BIND_QUICK_SETTINGS_TILE is signature-level and declared here
           rather than as a <uses-permission>: it is the system that must hold it to bind us. -->
      <service
        android:name=".pipeline.RecordTileService"
        android:exported="true"
        android:icon="@drawable/ic_notification_rec"
        android:label="@string/tile_label"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
        <intent-filter>
          <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
        <meta-data
          android:name="android.service.quicksettings.TOGGLEABLE_TILE"
          android:value="true" />
      </service>

      <!-- Persistent recording indicator + capture run in this foreground service.

           stopWithTask="false" is stated explicitly rather than left to the default: swiping the
           app out of Recents is how people tidy their task list, not how they end a meeting, and
           the primary way this app is used is with the phone set down and another app in front.
           RecordingService.onTaskRemoved is then the deliberate decision point. -->
      <service
        android:name=".pipeline.RecordingService"
        android:exported="false"
        android:stopWithTask="false"
        android:foregroundServiceType="microphone" />

      <!-- Runs meeting processing (VAD/ASR/diarize) so it survives the app being backgrounded or
           killed. Not yet started by anything — wired up in a later task.

           stopWithTask="false" mirrors RecordingService: swiping the app out of Recents is how
           people tidy their task list, not how they cancel a transcription, so processing keeps
           running with ProcessingService.onTaskRemoved as the deliberate decision point. -->
      <service
        android:name=".pipeline.ProcessingService"
        android:exported="false"
        android:stopWithTask="false"
        android:foregroundServiceType="dataSync" />

      <!-- Routes taps on the PiP window's Pause/Resume/Stop buttons to CaptureController. -->
      <receiver
        android:name=".pipeline.PipActionReceiver"
        android:exported="false" />

      <!-- Share exported minutes via a content URI. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
