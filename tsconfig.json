{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // "node" alongside "jest" because the golden-file tests read fixtures from disk. Without it
    // tsc cannot find 'fs', 'path' or __dirname, and those three errors were sitting in the tree
    // unnoticed — an explicit "types" list silently excludes every @types package not named in it.
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "cpp/third_party",
    "graphify-out",
    "_to_delete",
    // The licence server is a separate Node project with its own tsconfig and its own types
    // (node, not react-native). Compiling it under the app's config reports errors that are not
    // errors there.
    "server"
  ]
}
