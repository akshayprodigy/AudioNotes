# Copy to .env on the server and fill in. Never commit the filled-in version.

# The licence signing key. Generate once, ever, with `python -m app.keygen`.
# The public half goes into android/gradle.properties as licencePublicKey.
LICENCE_PRIVATE_KEY_PEM=

# Where the container is published. Host nginx proxies the subdomain to this, so it stays on
# localhost: nothing but nginx should be able to reach the app directly.
BIND_ADDRESS=127.0.0.1
HOST_PORT=9100

# Email. Only ever used for password reset links. Unconfigured, the server logs the message it
# would have sent and says loudly that it did not send it — the reset flow still works end to end,
# the mail simply does not arrive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# The origin to put in emailed links. Set this once there is a hostname: without it the link is
# built from the request's own Host header, which is how a reset email ends up pointing somewhere
# else entirely.
PUBLIC_BASE_URL=

# Google Play Billing. Needed to verify purchases made inside the Play build.
#
# PLAY_SERVICE_ACCOUNT_JSON takes either the service account JSON itself or a path to it. The
# account needs the Android Publisher API enabled, plus two permissions in Play Console:
# "View financial data" to read a purchase, and "Manage orders and subscriptions" to cancel one.
# Cancelling is not optional — deleting an account cancels the subscription first and refuses to
# delete if it cannot, so without that permission nobody can delete an account they have paid for.
#
# Until both variables are set, /api/billing/play/link answers 503 and nothing else is affected.
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=com.innocorelabs.verbale

# The admin console at /admin: who has subscribed.
#
# BOTH are required. With either one empty, every /admin route answers 404 — the console is off,
# and does not advertise that it exists. That is the intended state for a server that does not
# need one, so leaving these blank is a valid configuration and not a broken one.
#
# ADMIN_SESSION_SECRET signs the session cookie. Generate with `openssl rand -hex 32`. It has no
# default on purpose: a signing secret with a default value is a customer list readable by anyone
# who has read the source. Changing it signs everybody out, which is also how you revoke a session.
#
# VERBALE_ADMIN_EMAILS is a comma-separated allowlist of accounts that may sign in. They must be
# real accounts with real passwords — this grants access, it does not create anybody. Kept in the
# environment rather than the database so that nothing which can write the database can promote
# itself, and removing an address locks that person out on their very next request.
ADMIN_SESSION_SECRET=
VERBALE_ADMIN_EMAILS=

