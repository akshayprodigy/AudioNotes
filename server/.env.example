# Copy to .env on the server and fill in. Never commit the filled-in version.

# The hostname Caddy should serve and obtain a certificate for, e.g. audionotes.example.com.
# Use `:80` while there is no domain yet — plain HTTP, no certificate.
AUDIONOTES_SITE_ADDRESS=:80

# Which interface Caddy publishes on. 127.0.0.1 keeps the stack reachable only over SSH, which is
# where it should stay until a real hostname and a certificate exist. 0.0.0.0 to go public.
BIND_ADDRESS=127.0.0.1

# The licence signing key. Generate once, ever, with `python -m app.keygen`.
# The public half goes into android/gradle.properties as licencePublicKey.
LICENCE_PRIVATE_KEY_PEM=

# Razorpay. Until these are set, /subscribe answers 503 and everything else works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
