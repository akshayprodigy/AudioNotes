{
  "name": "audionotes-licence-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Accounts, subscriptions and licence tokens for AudioNotes.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx dist-test/*.test.js || node --test --import tsx src/*.test.ts",
    "keygen": "tsx src/keygen.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
